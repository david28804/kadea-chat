# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Base de données (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=kadea_chat

# Mail : smtp (Mailtrap en développement) ou brevo (API Brevo)
MAIL_MAILER=smtp
MAIL_FROM_NAME=Kadea Chat
MAIL_FROM_ADDRESS=noreply@kadeachat.com
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
# Clé API Brevo (si MAIL_MAILER=brevo)
BREVO_API_KEY=

# Administrateurs (adresses séparées par des virgules)
ADMIN_EMAILS=
