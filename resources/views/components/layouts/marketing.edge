<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'dark',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kadea Chat — La messagerie de votre équipe</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&family=Instrument+Serif:ital@1&display=swap"
    />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="landing">
    {{-- Menu : pilule centrée sur ordinateur, menu burger sur téléphone --}}
    <nav
      class="lnav"
      aria-label="Navigation"
      x-data="{ open: false }"
      x-bind:class="open && 'is-open'"
      x-on:keydown.escape.window="open = false"
    >
      <a href="/" class="lnav__brand">Kadea Chat<sup>*</sup></a>
      <button
        type="button"
        class="lnav__burger"
        aria-controls="lnav-links"
        x-bind:aria-expanded="open"
        x-bind:aria-label="open ? 'Fermer le menu' : 'Ouvrir le menu'"
        x-on:click="open = !open"
      >
        <span x-show="!open">
          @svg('lucide:menu', { width: 22, height: 22 })
        </span>
        <span x-show="open" x-cloak>
          @svg('lucide:x', { width: 22, height: 22 })
        </span>
      </button>
      <div id="lnav-links" class="lnav__links" x-on:click="if ($event.target.closest('a')) open = false">
        <a href="#a-propos">À propos</a>
        <a href="#fonctionnalites">Fonctionnalités</a>
        @if(auth?.user)
          @form({ route: 'session.destroy', method: 'POST', class: 'lnav__form' })
            <button type="submit">Se déconnecter</button>
          @end
        @else
          @link({ route: 'session.create' })
            Se connecter
          @end
        @end
      </div>
      @!themeToggle()
    </nav>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
