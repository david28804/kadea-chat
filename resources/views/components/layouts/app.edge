{{--
  Navigation principale (barre verticale à gauche).
  Ajoute une entrée ici pour chaque nouvelle zone de l'application.
--}}
@let(nav = [{ label: 'Conversations', route: 'dashboard', icon: 'lucide:message-circle' }])
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitle ? `${pageTitle} - Kadea Chat` : 'Kadea Chat' }}</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="shell">
      <nav class="rail" aria-label="Navigation principale">
        <a href="/" class="rail__logo" aria-label="Kadea Chat">K</a>

        @each(item in nav)
          @navLink({ route: item.route, class: 'rail__item' })
            @svg(item.icon, { width: 22, height: 22 })
            <span class="sr-only">{{ item.label }}</span>
          @end
        @end

        <div class="rail__bottom">
          @!themeToggle()
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="iconbtn" aria-label="Se déconnecter" title="Se déconnecter">
              @svg('lucide:log-out', { width: 16, height: 16 })
            </button>
          @end
          <span class="rail__avatar">{{ auth.user?.initials }}</span>
        </div>
      </nav>

      <div class="shell__main">{{{ await $slots.main() }}}</div>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>