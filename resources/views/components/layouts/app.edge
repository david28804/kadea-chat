{{-- Application (conversations, profil) : thème de l'accueil, sombre par défaut, clair au choix --}}
@let(pageTitle = $props.get('title'))
<!DOCTYPE html>
<html
  lang="fr"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'dark',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {{ csrfMeta() }}
    <title>{{ pageTitle ? `${pageTitle} - Kadea Chat` : 'Kadea Chat' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap"
    />
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="kc">
    <div class="shell" data-user-id="{{ auth.user?.id }}">
      <div class="shell__main">{{{ await $slots.main() }}}</div>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
