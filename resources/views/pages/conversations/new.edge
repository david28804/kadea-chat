@layouts.app({ title: 'Nouvelle conversation' })
  <div class="newconv">
    <div class="newconv__inner">
      <a href="{{ route('dashboard') }}" class="il newconv__back">← Retour aux conversations</a>
      <h1 class="newconv__title">Nouvelle conversation</h1>
      <p class="newconv__sub">Choisissez une personne pour démarrer une discussion privée.</p>
            <p style="margin-top: 10px;">
        <a href="{{ route('groups.create') }}" class="btn btn--secondary btn--sm">Créer un groupe</a>
      </p>

      <form method="GET" action="{{ route('conversations.create') }}" class="newconv__search">
        <input
          type="search"
          name="q"
          value="{{ q }}"
          placeholder="Rechercher par nom ou e-mail…"
          class="field__input"
          aria-label="Rechercher une personne"
        />
        <button type="submit" class="btn btn--secondary">Rechercher</button>
      </form>

      <div class="newconv__list">
        @if(people.length)
          @each(person in people)
            @form({ route: 'conversations.store', method: 'POST' })
              <input type="hidden" name="userId" value="{{ person.id }}" />
              <button type="submit" class="person">
                <span class="conv__avatar">{{ person.initials }}</span>
                <span class="person__text">
                  <span class="conv__name">{{ person.name }}</span>
                  <span class="conv__preview">{{ person.email }}</span>
                </span>
              </button>
            @end
          @end
        @else
          <p class="convlist__empty">
            Aucune personne trouvée. Une personne apparaît ici après avoir créé un compte et confirmé son e-mail.
          </p>
        @end
      </div>
    </div>
  </div>
@end