@layouts.app({ title: active ? active.title : 'Conversations' })
  <div class="chatapp {{ active ? 'chatapp--open' : '' }}">
    <aside
      class="convlist"
      x-data="convList"
      data-search-url="{{ route('messages.search') }}"
    >
      <div class="convlist__head">
        <h1 class="convlist__title"><a href="/">Kadea Chat<sup>*</sup></a></h1>
        {{--
          Navigation principale : ajoute une entrée ici pour chaque nouvelle zone.
          Une entrée avec `step` ouvre la fenêtre « Nouveau » au lieu d'une page.
        --}}
        @let(nav = [
          { label: 'Conversations', route: 'dashboard', icon: 'lucide:message-circle' },
          { label: 'Contacts', step: 'private', icon: 'lucide:user-plus' },
          { label: 'Groupes', step: 'group', icon: 'lucide:users' },
          { label: 'Paramètres', route: 'profile.edit', icon: 'lucide:settings' },
        ])
        <nav class="convnav" aria-label="Navigation principale">
          @each(item in nav)
            @if(item.step)
              <button
                type="button"
                class="convnav__item"
                title="{{ item.label }}"
                x-on:click="$dispatch('newchat', '{{ item.step }}')"
              >
                @svg(item.icon, { width: 20, height: 20 })
                <span class="sr-only">{{ item.label }}</span>
              </button>
            @else
              @navLink({ route: item.route, class: 'convnav__item', title: item.label })
                @svg(item.icon, { width: 20, height: 20 })
                <span class="sr-only">{{ item.label }}</span>
              @end
            @end
          @end
          <button
            type="button"
            class="convnav__item convnav__item--new"
            title="Nouveau"
            aria-label="Nouvelle conversation ou nouveau groupe"
            x-on:click="$dispatch('newchat', 'choice')"
          >
            @svg('lucide:plus', { width: 20, height: 20 })
          </button>
        </nav>
      </div>

      <div class="convlist__search">
        <input
          type="search"
          class="field__input"
          placeholder="Rechercher une conversation ou un message…"
          aria-label="Rechercher une conversation ou un message"
          x-model="q"
          x-on:input.debounce.300ms="findMessages()"
        />
      </div>

      <div class="convfilters">
        <button type="button" x-on:click="f = 'all'" x-bind:aria-pressed="f === 'all'">Toutes</button>
        <button type="button" x-on:click="f = 'unread'" x-bind:aria-pressed="f === 'unread'">Non lues</button>
        <button type="button" x-on:click="f = 'groups'" x-bind:aria-pressed="f === 'groups'">Groupes</button>
      </div>

      <div class="convlist__body">
        @if(conversations.length)
          @each(conversation in conversations)
            <a
              href="{{ route('conversations.show', { id: conversation.id }) }}"
              class="conv {{ active && active.id === conversation.id ? 'conv--active' : '' }}"
              data-title="{{ conversation.title }}"
              data-group="{{ conversation.isGroup ? '1' : '0' }}"
              data-unread="{{ conversation.unread }}"
              x-show="ok($el)"
            >
              <span
                class="conv__avatar {{ conversation.isGroup ? 'conv__avatar--group' : '' }} {{ conversation.online ? 'is-online' : '' }}"
                data-presence-user="{{ conversation.otherId ?? '' }}"
              >
                @if(conversation.avatar)
                  <img src="/{{ conversation.avatar }}" alt="" class="conv__img" />
                @else
                  {{ conversation.initials }}
                @end
              </span>
              <span class="conv__body">
                <span class="conv__row">
                  <span class="conv__name">{{ conversation.title }}</span>
                  <span class="conv__time">{{ conversation.time }}</span>
                </span>
                <span class="conv__row conv__row--sub">
                  <span class="conv__preview">{{ conversation.preview }}</span>
                  @if(conversation.unread > 0)
                    <span class="conv__badge">{{ conversation.unread }}</span>
                  @end
                </span>
              </span>
            </a>
          @end
        @else
          <p class="convlist__empty">Aucune conversation pour le moment.</p>
        @end

        {{-- Messages qui contiennent le mot tapé dans la barre de recherche --}}
        <section class="msgresults" x-show="q.trim().length >= 2" x-cloak aria-live="polite">
          <h2 class="msgresults__title">Messages</h2>
          <p class="convlist__empty" x-show="searching && !results.length">Recherche…</p>
          <p class="convlist__empty" x-show="!searching && searchedFor && !results.length">
            Aucun message ne contient « <span x-text="searchedFor"></span> ».
          </p>
          <template x-for="result in results" x-bind:key="result.id">
            <a x-bind:href="result.url" class="msgresult">
              <span class="conv__row">
                <span class="conv__name" x-text="result.title"></span>
                <span class="conv__time" x-text="result.time"></span>
              </span>
              <span class="msgresult__text">
                <template x-if="result.author">
                  <span class="msgresult__author" x-text="result.author + ' : '"></span>
                </template>
                <template x-for="(part, index) in parts(result.snippet)" x-bind:key="index">
                  <span x-bind:class="part.hit && 'msgresult__hit'" x-text="part.text"></span>
                </template>
              </span>
            </a>
          </template>
        </section>
      </div>

      <div class="convlist__foot">
        <div class="convme">
          <a href="{{ route('profile.edit') }}" class="convme__link" title="Mon profil">
            <span class="conv__avatar me-avatar is-online">
              @if(auth.user?.avatar)
                <img src="/{{ auth.user.avatar }}" alt="" class="conv__img" />
              @else
                {{ auth.user?.initials }}
              @end
            </span>
            <span class="convme__name">{{ auth.user?.fullName ?? auth.user?.email }}</span>
          </a>
          @!themeToggle()
          @form({ route: 'session.destroy', method: 'POST' })
            <button type="submit" class="iconbtn" aria-label="Se déconnecter" title="Se déconnecter">
              @svg('lucide:log-out', { width: 16, height: 16 })
            </button>
          @end
        </div>
      </div>
    </aside>

    <section class="chatpane">
      @if(active)
        <header class="chathead">
          <a href="{{ route('dashboard') }}" class="iconbtn chathead__back" aria-label="Retour à la liste">
            @svg('lucide:arrow-left', { width: 16, height: 16 })
          </a>
          <span
            class="conv__avatar {{ active.isGroup ? 'conv__avatar--group' : '' }} {{ active.online ? 'is-online' : '' }}"
            data-presence-user="{{ active.otherId ?? '' }}"
          >
            @if(active.avatar)
              <img src="/{{ active.avatar }}" alt="" class="conv__img" />
            @else
              {{ active.initials }}
            @end
          </span>
          <span class="chathead__text">
            <span class="conv__name">{{ active.title }}</span>
            <span class="conv__preview">{{ active.subtitle }}</span>
          </span>
          {{-- Recherche dans la conversation : la loupe déplie le champ --}}
          <form
            method="GET"
            action="{{ route('conversations.show', { id: active.id }) }}"
            class="chatsearch"
            role="search"
            x-data="{ open: {{ search ? 'true' : 'false' }} }"
            x-bind:class="open && 'is-open'"
          >
            <input
              type="search"
              name="q"
              value="{{ search }}"
              placeholder="Rechercher un message…"
              class="field__input"
              aria-label="Rechercher dans la conversation"
              maxlength="100"
              x-ref="q"
              x-show="open"
              x-on:keydown.escape="open = false"
            />
            <button
              type="submit"
              class="iconbtn"
              title="Chercher dans tout l'historique"
              aria-label="Chercher dans tout l'historique"
              x-show="open"
              x-cloak
            >
              @svg('lucide:search', { width: 16, height: 16 })
            </button>
            <button
              type="button"
              class="iconbtn"
              title="Rechercher dans la conversation"
              aria-label="Rechercher dans la conversation"
              x-show="!open"
              x-on:click="open = true; $nextTick(() => $refs.q.focus())"
            >
              @svg('lucide:search', { width: 16, height: 16 })
            </button>
          </form>
          @if(!active.isGroup && active.otherId && !active.blockedByMe)
            <div class="chathead__actions">
              <details class="blockbox">
                <summary class="iconbtn blockbox__btn" title="Bloquer" aria-label="Bloquer cette personne">
                  @svg('lucide:ban', { width: 14, height: 14 })
                </summary>
                @form({
                  route: 'users.block',
                  routeParams: { id: active.otherId },
                  method: 'POST',
                })
                  <span>Bloquer cette personne ?</span>
                  <button type="submit" class="msg__yes">Oui</button>
                @end
              </details>
            </div>
          @end
          @if(active.isGroup)
            <div class="chathead__actions">
              <button
                type="button"
                class="iconbtn"
                title="Membres du groupe"
                aria-label="Membres du groupe"
                x-data
                x-on:click="$dispatch('groupinfo')"
              >
                @svg('lucide:users', { width: 16, height: 16 })
              </button>
            </div>
          @end
        </header>

        @if(active.isGroup)
          {{-- Membres du groupe : voir, ajouter, retirer, quitter --}}
          <dialog
            class="newchat"
            aria-labelledby="groupinfo-title"
            x-data="{ q: '', match(el) { return el.dataset.search.includes(this.q.trim().toLowerCase()) } }"
            x-on:groupinfo.window="q = ''; $el.showModal()"
            x-on:click="$event.target === $el && $el.close()"
          >
            <div class="newchat__box">
              <div class="newchat__head">
                <h2 id="groupinfo-title" class="newchat__title">
                  Membres
                  <span class="groupinfo__count">{{ active.members.length }}</span>
                </h2>
                <button type="button" class="iconbtn" aria-label="Fermer" x-on:click="$root.close()">
                  @svg('lucide:x', { width: 16, height: 16 })
                </button>
              </div>

              <div class="newchat__list">
                @each(member in active.members)
                  <div class="person groupinfo__member">
                    <span class="conv__avatar">
                      @if(member.avatar)
                        <img src="/{{ member.avatar }}" alt="" class="conv__img" />
                      @else
                        {{ member.initials }}
                      @end
                    </span>
                    <span class="person__text">
                      <span class="conv__name">{{ member.name }}{{ member.isMe ? ' (vous)' : '' }}</span>
                      <span class="conv__preview">{{ member.isAdmin ? 'Administrateur' : 'Membre' }}</span>
                    </span>
                    @if(active.iAmAdmin && !member.isMe)
                      @form({
                        route: 'groups.members.remove',
                        routeParams: { id: active.id, userId: member.userId },
                        method: 'POST',
                        class: 'groupinfo__remove',
                        'x-on:submit': "confirm('Retirer cette personne du groupe ?') || $event.preventDefault()",
                      })
                        <button type="submit" class="btn btn--secondary btn--sm">Retirer</button>
                      @end
                    @end
                  </div>
                @end
              </div>

              @if(active.iAmAdmin)
                <details class="groupinfo__add">
                  <summary class="btn btn--secondary btn--sm">
                    @svg('lucide:user-plus', { width: 14, height: 14 })
                    Ajouter des membres
                  </summary>
                  @if(addable.length)
                    @form({
                      route: 'groups.members.add',
                      routeParams: { id: active.id },
                      method: 'POST',
                      class: 'newchat__form',
                    })
                      <input
                        type="search"
                        class="field__input"
                        placeholder="Rechercher une personne…"
                        aria-label="Rechercher une personne à ajouter"
                        x-model="q"
                      />
                      <div class="newchat__list">
                        @each(person in addable)
                          <label
                            class="person"
                            data-search="{{ `${person.name} ${person.email}`.toLowerCase() }}"
                            x-show="match($el)"
                          >
                            <input type="checkbox" name="members" value="{{ person.id }}" />
                            <span class="conv__avatar">
                              @if(person.avatar)
                                <img src="/{{ person.avatar }}" alt="" class="conv__img" />
                              @else
                                {{ person.initials }}
                              @end
                            </span>
                            <span class="person__text">
                              <span class="conv__name">{{ person.name }}</span>
                              <span class="conv__preview">{{ person.email }}</span>
                            </span>
                          </label>
                        @end
                      </div>
                      @!button({ text: 'Ajouter au groupe', type: 'submit', block: true })
                    @end
                  @else
                    <p class="convlist__empty">Tout le monde fait déjà partie du groupe.</p>
                  @end
                </details>
              @end

              @form({
                route: 'groups.leave',
                routeParams: { id: active.id },
                method: 'POST',
                'x-on:submit': "confirm('Quitter ce groupe ? Vous ne verrez plus ses messages.') || $event.preventDefault()",
              })
                <button type="submit" class="btn btn--ghost btn--block groupinfo__leave">
                  @svg('lucide:log-out', { width: 15, height: 15 })
                  Quitter le groupe
                </button>
              @end
            </div>
          </dialog>
        @end

        @if(search)
          <div class="searchbar">
            <span>
              {{ messages.length }} {{ messages.length > 1 ? 'résultats' : 'résultat' }} pour « {{ search }} »
            </span>
            <a href="{{ route('conversations.show', { id: active.id }) }}" class="il">Effacer la recherche</a>
          </div>
        @end

        {{-- Pendant une recherche, les nouveaux messages n'arrivent pas en direct --}}
        <div
          class="msgs"
          data-conversation-id="{{ active.id }}"
          data-user-id="{{ auth.user.id }}"
          data-group="{{ active.isGroup ? '1' : '0' }}"
          data-live="{{ search ? '0' : '1' }}"
          data-search="{{ search }}"
          x-data
          x-init="$el.scrollTop = $el.scrollHeight"
        >
          @if(messages.length)
            @each(message in messages)
              @if(message.showDay)
                <div class="msgs__day">{{ message.day }}</div>
              @end
              <div class="msg {{ message.isMine ? 'msg--mine' : '' }}" data-message-id="{{ message.id }}">
                @if(active.isGroup && !message.isMine)
                  <span class="msg__author">{{ message.author }}</span>
                @end
                @if(message.isDeleted)
                  <span class="msg__deleted">Ce message a été supprimé</span>
                @else
                  @if(message.attachment)
                    @if(message.attachment.isImage)
                      <a href="{{ message.attachment.url }}" target="_blank" rel="noopener" class="msg__image">
                        <img src="{{ message.attachment.url }}" alt="{{ message.attachment.name }}" loading="lazy" />
                      </a>
                    @else
                      <a href="{{ message.attachment.url }}" class="msg__file">
                        @svg('lucide:file-text', { width: 18, height: 18 })
                        <span class="msg__filename">{{ message.attachment.name }}</span>
                        <span class="msg__filesize">{{ message.attachment.size }}</span>
                      </a>
                    @end
                  @end
                  @if(message.content)
                    <span class="msg__text">{{ message.content }}</span>
                  @end
                @end
                <div class="msg__foot">
                  @if(message.isMine && !message.isDeleted)
                    <details class="msg__del">
                      <summary aria-label="Supprimer le message" title="Supprimer">
                        @svg('lucide:trash-2', { width: 13, height: 13 })
                      </summary>
                      @form({
                        route: 'messages.destroy',
                        routeParams: { id: message.id },
                        method: 'POST',
                      })
                        <span>Supprimer ?</span>
                        <button type="submit" class="msg__yes">Oui</button>
                      @end
                    </details>
                  @end
                  <span class="msg__time">{{ message.time }}</span>
                  @if(message.isMine && !message.isDeleted)
                    <span class="msg__tick" data-status="{{ message.status }}" title="Statut du message">{{ message.status === 'sent' ? '✓' : '✓✓' }}</span>
                  @end
                </div>
              </div>
            @end
          @else
            <p class="msgs__empty">
              {{ search ? 'Aucun message ne correspond à votre recherche.' : 'Aucun message pour le moment. Écrivez le premier !' }}
            </p>
          @end
        </div>

        <div class="typing" data-typing aria-live="polite"></div>

        @if(active.blockedByMe)
          <div class="composer composer--notice">
            <span>Vous avez bloqué cette personne.</span>
            @form({
              route: 'users.unblock',
              routeParams: { id: active.otherId },
              method: 'POST',
            })
              <button type="submit" class="btn btn--secondary btn--sm">Débloquer</button>
            @end
          </div>
        @elseif(active.blockedMe)
          <div class="composer composer--notice">
            <span>Vous ne pouvez pas envoyer de message à cette personne.</span>
          </div>
        @else
          <form
            method="POST"
            action="{{ route('messages.store', { id: active.id }) }}"
            enctype="multipart/form-data"
            class="composer"
            x-data="{ submitting: false, file: '', tooBig: false }"
            x-on:submit="submitting = true"
          >
            {{ csrfField() }}

            <div class="composer__file" x-show="file" x-cloak>
              @svg('lucide:paperclip', { width: 14, height: 14 })
              <span x-text="file"></span>
              <button
                type="button"
                aria-label="Retirer le fichier"
                x-on:click="file = ''; $refs.picker.value = ''"
              >
                ×
              </button>
            </div>
            <div class="composer__note" x-show="tooBig" x-cloak>Fichier trop lourd : 5 Mo maximum.</div>

            <input
              type="file"
              name="attachment"
              class="composer__picker"
              x-ref="picker"
              accept=".jpg,.jpeg,.png,.gif,.webp,.pdf,.txt,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip"
              x-on:change="const f = $event.target.files[0]; if (f && f.size > 5 * 1024 * 1024) { $event.target.value = ''; file = ''; tooBig = true } else { file = f ? f.name : ''; tooBig = false }"
            />
            <button
              type="button"
              class="iconbtn composer__clip"
              aria-label="Joindre un fichier"
              title="Joindre un fichier"
              x-on:click="$refs.picker.click()"
            >
              @svg('lucide:paperclip', { width: 16, height: 16 })
            </button>

            <textarea
              name="content"
              rows="1"
              class="composer__input"
              placeholder="Écrire un message…"
              aria-label="Écrire un message"
              autocomplete="off"
              maxlength="2000"
              x-on:keydown.enter="if (!$event.shiftKey) { $event.preventDefault(); $el.form.requestSubmit() }"
            ></textarea>
            <button type="submit" class="btn btn--primary composer__send" x-bind:disabled="submitting">
              @svg('lucide:send', { width: 15, height: 15 })
              Envoyer
            </button>
          </form>
        @end
      @else
        <div class="empty">
          <div class="empty__mark">
            @svg('lucide:message-circle', { width: 22, height: 22 })
          </div>
          <h1>Vos conversations commencent ici</h1>
          <p>Sélectionnez une conversation dans la liste, ou démarrez-en une nouvelle.</p>
          <button type="button" class="btn btn--primary" x-data x-on:click="$dispatch('newchat', 'choice')">
            Nouvelle conversation
          </button>
        </div>
      @end
    </section>

    {{-- Fenêtre « Nouveau » : conversation privée ou groupe, sans changer de page --}}
    <dialog
      class="newchat"
      x-data="newChat"
      data-open-step="{{ flashMessages.get('newchat') ?? (flashMessages.has('inputErrorsBag.name') ? 'group' : '') }}"
      aria-labelledby="newchat-title"
      x-on:newchat.window="open($event.detail)"
      x-on:click="$event.target === $el && close()"
    >
      <div class="newchat__box">
        <div class="newchat__head">
          <button
            type="button"
            class="iconbtn"
            aria-label="Retour"
            x-show="step !== 'choice'"
            x-on:click="step = 'choice'"
          >
            @svg('lucide:arrow-left', { width: 16, height: 16 })
          </button>
          <h2 id="newchat-title" class="newchat__title">
            <span x-show="step === 'choice'">Nouveau</span>
            <span x-show="step === 'private'">Nouvelle conversation</span>
            <span x-show="step === 'group'">Créer un groupe</span>
          </h2>
          <button type="button" class="iconbtn" aria-label="Fermer" x-on:click="close()">
            @svg('lucide:x', { width: 16, height: 16 })
          </button>
        </div>

        <div class="newchat__step" x-show="step === 'choice'">
          <button type="button" class="newchat__option" x-on:click="step = 'private'">
            <span class="newchat__icon">
              @svg('lucide:message-circle', { width: 20, height: 20 })
            </span>
            <span class="newchat__text">
              <span class="newchat__label">Nouvelle conversation</span>
              <span class="newchat__sub">Discuter en privé avec une personne</span>
            </span>
          </button>
          <button type="button" class="newchat__option" x-on:click="step = 'group'">
            <span class="newchat__icon">
              @svg('lucide:users', { width: 20, height: 20 })
            </span>
            <span class="newchat__text">
              <span class="newchat__label">Créer un groupe</span>
              <span class="newchat__sub">Discuter à plusieurs</span>
            </span>
          </button>
        </div>

        <div class="newchat__step" x-show="step === 'private'">
          <input
            type="search"
            class="field__input"
            placeholder="Rechercher par nom ou e-mail…"
            aria-label="Rechercher une personne"
            x-model="q"
          />
          <div class="newchat__list">
            @each(person in people)
              @form({ route: 'conversations.store', method: 'POST' })
                <input type="hidden" name="userId" value="{{ person.id }}" />
                <button
                  type="submit"
                  class="person"
                  data-search="{{ `${person.name} ${person.email}`.toLowerCase() }}"
                  x-show="match($el)"
                >
                  <span class="conv__avatar">
                    @if(person.avatar)
                      <img src="/{{ person.avatar }}" alt="" class="conv__img" />
                    @else
                      {{ person.initials }}
                    @end
                  </span>
                  <span class="person__text">
                    <span class="conv__name">{{ person.name }}</span>
                    <span class="conv__preview">{{ person.email }}</span>
                  </span>
                </button>
              @end
            @else
              <p class="convlist__empty">
                Aucune personne trouvée. Une personne apparaît ici après avoir créé un compte et confirmé son e-mail.
              </p>
            @end
          </div>
        </div>

        <div class="newchat__step" x-show="step === 'group'">
          @form({ route: 'groups.store', method: 'POST', class: 'newchat__form' })
            @field.root({ name: 'name' })
              @!field.label({ text: 'Nom du groupe' })
              @!input.control({ type: 'text', placeholder: 'Ex. Promo Kadea 2026' })
              @!field.error()
            @end
            <input
              type="search"
              class="field__input"
              placeholder="Rechercher un membre…"
              aria-label="Rechercher un membre"
              x-model="q"
            />
            <div class="newchat__list">
              @each(person in people)
                <label
                  class="person"
                  data-search="{{ `${person.name} ${person.email}`.toLowerCase() }}"
                  x-show="match($el)"
                >
                  <input type="checkbox" name="members" value="{{ person.id }}" />
                  <span class="conv__avatar">
                    @if(person.avatar)
                      <img src="/{{ person.avatar }}" alt="" class="conv__img" />
                    @else
                      {{ person.initials }}
                    @end
                  </span>
                  <span class="person__text">
                    <span class="conv__name">{{ person.name }}</span>
                    <span class="conv__preview">{{ person.email }}</span>
                  </span>
                </label>
              @else
                <p class="convlist__empty">Aucune personne disponible pour le moment.</p>
              @end
            </div>
            @!button({ text: 'Créer le groupe', type: 'submit', block: true })
          @end
        </div>
      </div>
    </dialog>
  </div>
@end