@layouts.auth()
  <h1 class="auth__title">Mot de passe oublié</h1>
  <p class="auth__sub">Entrez votre adresse e-mail pour recevoir un lien de réinitialisation.</p>
  @form({
    route: 'password.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'you@example.com',
      })
      @!field.error()
    @end
    @!button({
      text: 'Envoyer le lien',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Envoi en cours…' : 'Envoyer le lien'",
    })
  @end

  <p class="auth__foot">
    Vous vous souvenez du mot de passe ?
    @link({ route: 'session.create', class: 'il' })
      Se connecter
    @end
  </p>
@end