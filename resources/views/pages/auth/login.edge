@layouts.auth()
  <h1 class="auth__title">Ravi de vous revoir</h1>
  <p class="auth__sub">Connectez-vous pour continuer.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'vous@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    <p class="auth__foot" style="text-align: right; margin: 0;">
      @link({ route: 'password.forgot', class: 'il' })
        Mot de passe oublié ?
      @end
    </p>
    @!button({
      text: 'Se connecter',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Connexion en cours…' : 'Se connecter'",
    })
  @end

  <p class="auth__foot">
    Vous n'avez pas encore de compte ?
    @link({ route: 'new_account.create', class: 'il' })
      Créer un compte
    @end
  </p>
@end