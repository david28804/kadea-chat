@layouts.auth()
  <h1 class="auth__title">Créez votre compte</h1>
  <p class="auth__sub">Rejoignez Kadea Chat et discutez avec votre équipe.</p>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nom complet' })
      @!input.control({ autocomplete: 'name', placeholder: 'Ada Lovelace' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'Adresse e-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'vous@exemple.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Mot de passe' })
      <div class="pwfield" x-data="{ show: false }">
        @!input.control({
          type: 'password',
          autocomplete: 'new-password',
          placeholder: '••••••••',
          'x-bind:type': "show ? 'text' : 'password'",
        })
        <button
          type="button"
          class="pwfield__toggle"
          x-on:click="show = !show"
          x-bind:aria-label="show ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
          x-bind:aria-pressed="show"
          aria-label="Afficher le mot de passe"
        >
          <span x-show="!show">
            @svg('lucide:eye', { width: 17, height: 17 })
          </span>
          <span x-show="show" x-cloak>
            @svg('lucide:eye-off', { width: 17, height: 17 })
          </span>
        </button>
      </div>
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmer le mot de passe' })
      <div class="pwfield" x-data="{ show: false }">
        @!input.control({
          type: 'password',
          autocomplete: 'new-password',
          placeholder: '••••••••',
          'x-bind:type': "show ? 'text' : 'password'",
        })
        <button
          type="button"
          class="pwfield__toggle"
          x-on:click="show = !show"
          x-bind:aria-label="show ? 'Masquer le mot de passe' : 'Afficher le mot de passe'"
          x-bind:aria-pressed="show"
          aria-label="Afficher le mot de passe"
        >
          <span x-show="!show">
            @svg('lucide:eye', { width: 17, height: 17 })
          </span>
          <span x-show="show" x-cloak>
            @svg('lucide:eye-off', { width: 17, height: 17 })
          </span>
        </button>
      </div>
      @!field.error()
    @end
    @!button({
      text: 'Créer mon compte',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Un instant…' : 'Créer mon compte'",
    })
  @end

  <p class="auth__foot">
    Vous avez déjà un compte ?
    @link({ route: 'session.create', class: 'il' })
      Se connecter
    @end
  </p>
@end