@layouts.app({ title: 'Mon profil' })
  <div class="newconv">
    <div class="newconv__inner">
      <a href="{{ route('dashboard') }}" class="il newconv__back">← Retour aux conversations</a>
      <h1 class="newconv__title">Mon profil</h1>
      <p class="newconv__sub">Gérez vos informations et votre mot de passe.</p>

      <div class="panel" style="margin-top: 20px;">
        <h2 class="section__title">Photo de profil</h2>

        <div class="avatarbox" data-avatar-picker>
          <div class="avatarpick__circle">
            <span class="conv__avatar avatar-lg">
              @if(me.avatar)
                <img
                  src="/{{ me.avatar }}"
                  alt="Votre photo de profil"
                  class="conv__img"
                  width="84"
                  height="84"
                />
              @else
                {{ me.initials }}
              @end
            </span>
            <button
              type="button"
              class="avatarpick__cam"
              data-avatar-open
              aria-label="Changer la photo de profil"
              title="Changer la photo"
            >
              @svg('lucide:camera', { width: 15, height: 15 })
            </button>
          </div>

          <div class="avatarbox__forms">
            <p class="field__hint">
              Cliquez sur l'appareil photo pour choisir une image, puis ajustez-la dans le cercle.
            </p>
            <input
              type="file"
              accept="image/png,image/jpeg,image/webp"
              data-avatar-input
              hidden
            />

            @form({
              route: 'profile.avatar',
              method: 'POST',
              enctype: 'multipart/form-data',
              'data-avatar-form': 'true',
            })
              <input type="file" name="avatar" data-avatar-final hidden />
            @end

            @if(me.avatar)
              @form({ route: 'profile.avatar.destroy', method: 'POST' })
                <button type="submit" class="il">Supprimer la photo</button>
              @end
            @end
          </div>

          <div class="cropper" data-cropper hidden role="dialog" aria-modal="true" aria-label="Ajuster la photo">
            <div class="cropper__box">
              <h2 class="cropper__title">Ajuster la photo</h2>
              <p class="cropper__hint">Glissez la photo pour la placer, et utilisez le curseur pour zoomer.</p>
              <div class="cropper__stage" data-cropper-stage>
                <img class="cropper__img" data-cropper-img alt="" draggable="false" />
              </div>
              <input
                type="range"
                class="cropper__zoom"
                min="1"
                max="3"
                step="0.01"
                value="1"
                data-cropper-zoom
                aria-label="Zoom"
              />
              <div class="cropper__actions">
                <button type="button" class="btn btn--secondary" data-cropper-cancel>Annuler</button>
                <button type="button" class="btn btn--primary" data-cropper-save>Enregistrer</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="panel" style="margin-top: 20px;">
        <h2 class="section__title">Informations</h2>
        @form({ route: 'profile.update', method: 'POST', class: 'auth__form' })
          @field.root({ name: 'fullName' })
            @!field.label({ text: 'Nom complet' })
            <input
              type="text"
              name="fullName"
              value="{{ me.fullName }}"
              class="field__input"
              autocomplete="name"
            />
            @!field.error()
          @end
          <div class="field">
            <span class="field__label">Adresse e-mail</span>
            <input type="email" value="{{ me.email }}" class="field__input" disabled />
            <p class="field__hint">L'adresse e-mail ne peut pas être modifiée.</p>
          </div>
          @!button({ text: 'Enregistrer', type: 'submit' })
        @end
      </div>

      <div class="panel" style="margin-top: 20px;">
        <h2 class="section__title">Changer le mot de passe</h2>
        @form({ route: 'profile.password', method: 'POST', class: 'auth__form' })
          @field.root({ name: 'currentPassword' })
            @!field.label({ text: 'Mot de passe actuel' })
            @!input.control({ type: 'password', autocomplete: 'current-password', placeholder: '••••••••' })
            @!field.error()
          @end
          @field.root({ name: 'password' })
            @!field.label({ text: 'Nouveau mot de passe' })
            @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
            @!field.error()
          @end
          @field.root({ name: 'passwordConfirmation' })
            @!field.label({ text: 'Confirmer le nouveau mot de passe' })
            @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
            @!field.error()
          @end
          @!button({ text: 'Changer le mot de passe', type: 'submit' })
        @end
      </div>
    </div>
  </div>
@end