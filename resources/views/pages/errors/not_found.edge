@layouts.marketing()
  <main class="lerror">
    <p class="lstory__label">Erreur 404</p>
    <h1 class="lerror__title">Page introuvable, <em>elle n'existe pas.</em></h1>
    <p class="lerror__text">Vérifiez l'adresse ou revenez à l'accueil.</p>
    <a href="/" class="lpill">
      Retour à l'accueil
      <span class="lpill__arrow">
        @svg('lucide:arrow-right', { width: 18, height: 18 })
      </span>
    </a>
  </main>
@end
