@layouts.marketing()
  <main class="lerror">
    <p class="lstory__label">Erreur 500</p>
    <h1 class="lerror__title">Un problème est survenu, <em>réessayez dans un instant.</em></h1>
    <p class="lerror__text">Le serveur n'a pas pu traiter votre demande.</p>
    <a href="/" class="lpill">
      Retour à l'accueil
      <span class="lpill__arrow">
        @svg('lucide:arrow-right', { width: 18, height: 18 })
      </span>
    </a>
  </main>
@end
