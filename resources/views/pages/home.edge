@let(cards = [
  {
    icon: 'lucide:message-circle',
    title: 'Messagerie en temps réel.',
    points: [
      'Messages instantanés, sans recharger la page',
      'Créez un compte et connectez-vous en quelques secondes',
      'Accusés envoyé, reçu et lu',
      'Présence en ligne de vos contacts',
    ],
  },
  {
    icon: 'lucide:users',
    title: 'Groupes et partage.',
    points: [
      'Créez un groupe en quelques clics',
      'Partage de fichiers et d’images',
      'Recherche dans chaque conversation',
    ],
  },
  {
    icon: 'lucide:shield',
    title: 'Vous gardez la main.',
    points: [
      'Bloquez une personne à tout moment',
      'Supprimez vos messages quand vous voulez',
      'Photo de profil, recadrée à votre goût',
    ],
  },
])
@layouts.marketing()
  <main>
    {{-- Présentation --}}
    <section class="lhero">
      <h1 class="lhero__mark">Kadea Chat<sup>*</sup></h1>
      <div class="lhero__side">
        <p class="lhero__text">
          Kadea Chat est la messagerie de votre équipe : discussions privées, groupes et
          partage de fichiers, en temps réel, au même endroit.
        </p>
        @link({ route: 'new_account.create', class: 'lpill' })
          Créer un compte
          <span class="lpill__arrow">
            @svg('lucide:arrow-right', { width: 18, height: 18 })
          </span>
        @end
      </div>
    </section>

    {{-- Manifeste --}}
    <section id="a-propos" class="lstory">
      <p class="lstory__label">Messagerie d'équipe</p>
      <h2 class="lstory__title">
        Kadea Chat est une messagerie,
        <em>née d'un besoin simple.</em>
        Réunir votre équipe, vos idées et vos fichiers dans une conversation qui avance.
      </h2>
      <p class="lstory__text" data-reveal>
        Fini les messages éparpillés entre plusieurs applications. Avec Kadea Chat, chacun retrouve ses
        discussions privées et ses groupes au même endroit, voit qui est en ligne et sait quand son
        message a été lu.
      </p>
    </section>

    {{-- Fonctionnalités --}}
    <section id="fonctionnalites" class="lfeat">
      <h2 class="lfeat__title">
        Une messagerie pensée pour les équipes qui avancent.
        <span>Simple à prendre en main. Rapide au quotidien.</span>
      </h2>

      <div class="lfeat__row">
        <div class="lcard lcard--visual">
          <p>Votre espace d'équipe.</p>
        </div>
        @each((card, index) in cards)
          <article class="lcard">
            <div class="lcard__top">
              <span class="lcard__icon">
                @svg(card.icon, { width: 20, height: 20 })
              </span>
              <span class="lcard__num">0{{ index + 1 }}</span>
            </div>
            <h3 class="lcard__title">{{ card.title }}</h3>
            <ul class="lcard__list">
              @each(point in card.points)
                <li>
                  @svg('lucide:check', { width: 16, height: 16 })
                  {{ point }}
                </li>
              @end
            </ul>
            @link({ route: auth.user ? 'dashboard' : 'new_account.create', class: 'lcard__more' })
              En savoir plus
              @svg('lucide:arrow-up-right', { width: 14, height: 14 })
            @end
          </article>
        @end
      </div>
    </section>
  </main>

  <footer class="lfooter">
    <span>© {{ new Date().getFullYear() }} Kadea Chat</span>
    <span>Design by <strong>David Mbiya</strong></span>
  </footer>
@end
